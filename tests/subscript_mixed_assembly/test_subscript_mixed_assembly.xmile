<xmile xmlns="http://docs.oasis-open.org/xmile/ns/XMILE/v1.0" version="1.0">
    <isee:prefs show_module_prefix="true" layer="model"/>
    <header>
        <options namespace="std"/>
        <vendor>Ventana Systems, xmutil</vendor>
        <product lang="en">Vensim, xmutil</product>
    </header>
    <sim_specs isee:simulation_delay="0" method="Euler" time_units="Months">
        <start>0</start>
        <stop>3</stop>
        <dt>1</dt>
    </sim_specs>
    <dimensions>
        <dim name="Dim2">
            <elem name="D"/>
            <elem name="E"/>
        </dim>
        <dim name="Dim1">
            <elem name="A"/>
            <elem name="B"/>
            <elem name="C"/>
        </dim>
    </dimensions>
    <model>
        <variables>
            <aux name="TIME STEP">
                <doc>	The time step for the simulation.</doc>
                <eqn>1</eqn>
                <units>Month</units>
            </aux>
            <aux name="INITIAL TIME">
                <doc>	The initial time for the simulation.</doc>
                <eqn>0</eqn>
                <units>Month</units>
            </aux>
            <aux name="FINAL TIME">
                <doc>	The final time for the simulation.</doc>
                <eqn>3</eqn>
                <units>Month</units>
            </aux>
            <aux name="mixed assembly">
                <dimensions>
                    <dim name="Dim1"/>
                    <dim name="Dim2"/>
                </dimensions>
                <element subscript="A,D">
                    <eqn>subset[A]</eqn>
                </element>
                <element subscript="A,E">
                    <eqn>2.1</eqn>
                </element>
                <element subscript="B,D">
                    <eqn>subset[B]</eqn>
                </element>
                <element subscript="B,E">
                    <eqn>2.2</eqn>
                </element>
                <element subscript="C,D">
                    <eqn>subset[C]</eqn>
                </element>
                <element subscript="C,E">
                    <eqn>2.3</eqn>
                </element>
            </aux>
            <aux name="subset">
                <dimensions>
                    <dim name="Dim1"/>
                </dimensions>
                <element subscript="A">
                    <eqn>1.1</eqn>
                </element>
                <element subscript="B">
                    <eqn>1.2</eqn>
                </element>
                <element subscript="C">
                    <eqn>1.3</eqn>
                </element>
            </aux>
            <aux name="SAVEPER">
                <doc>	The frequency with which output is stored.</doc>
                <eqn>TIME_STEP</eqn>
                <units>Month</units>
            </aux>
        </variables>
        <views>
            <view>
                <aux name="mixed_assembly" x="445" y="103"/>
                <aux name="subset" x="240" y="100"/>
                <connector uid="3" angle="-0.83841497440212076">
                    <from>subset</from>
                    <to>mixed_assembly</to>
                </connector>
                <connector uid="17" angle="90">
                    <from>TIME_STEP</from>
                    <to>SAVEPER</to>
                </connector>
                <aux name="SAVEPER" x="100" y="110"/>
                <aux name="FINAL_TIME" x="100" y="110"/>
                <aux name="INITIAL_TIME" x="100" y="110"/>
                <aux name="TIME_STEP" x="100" y="110"/>
            </view>
        </views>
    </model>
</xmile>
